# HackRepair Plugin Detective
# Many hardened sites block every PHP file inside wp-content/plugins/.
# The troubleshooter must still open when the site is broken, so this
# re-allows ONLY its two entry points. Both require an administrator
# login before they do anything. Everything else stays blocked.
<FilesMatch "^(index|api)\.php$">
	<IfModule mod_access_compat.c>
		Order allow,deny
		Allow from all
	</IfModule>
	<IfModule !mod_access_compat.c>
		<IfModule mod_authz_core.c>
			Require all granted
		</IfModule>
	</IfModule>
</FilesMatch>
